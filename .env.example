# Copy to .env and fill in. Never commit .env. On Render, set these under Environment.
DATABASE_URL="mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/campusnav?retryWrites=true&w=majority"
JWT_SECRET="replace-with-a-long-random-string"

# Optional. Only needed if the browser calls the API directly instead of through the
# Vercel /api rewrite, e.g. "https://smart-navigation-fe.vercel.app". Comma-separate several.
CORS_ORIGIN=""
